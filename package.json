{
  "name": "@reactleaf/modal",
  "version": "2.0.0-beta.0",
  "packageManager": "pnpm@10.11.0",
  "description": "React Modal Library with context",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev:docs": "pnpm --filter ./docs dev",
    "build:docs": "pnpm --filter ./docs build",
    "test": "jest",
    "publish:npm": "pnpm build && npm publish --access public --ignore-scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactleaf/modal.git"
  },
  "bugs": {
    "url": "https://github.com/reactleaf/modal/issues"
  },
  "homepage": "https://github.com/reactleaf/modal#readme",
  "keywords": [
    "react",
    "typescript",
    "modal",
    "context",
    "popup"
  ],
  "author": "Hyeonseok Yang <FourwingsY@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "classnames": "^2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.3.1",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.0",
    "vite": "^7.3.2"
  },
  "peerDependencies": {
    "react": "^16 || ^17 || ^18 || ^19",
    "react-dom": "^16 || ^17 || ^18 || ^19"
  }
}
