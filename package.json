{
  "name": "@reactleaf/modal",
  "version": "2.0.0-alpha.0",
  "packageManager": "pnpm@10.11.0",
  "description": "React Modal Library with context",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev:docs": "pnpm --filter ./docs dev",
    "build:docs": "pnpm --filter ./docs build",
    "preview:docs": "pnpm --filter ./docs preview",
    "test": "jest",
    "publish:npm": "npm run build && npm publish --access public --ignore-scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactleaf/modal.git"
  },
  "bugs": {
    "url": "https://github.com/reactleaf/modal/issues"
  },
  "homepage": "https://github.com/reactleaf/modal#readme",
  "keywords": [
    "react",
    "typescript",
    "modal",
    "context",
    "popup"
  ],
  "author": "Hyeonseok Yang <FourwingsY@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "classnames": "^2"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.3.1",
    "typescript": "^4"
  },
  "peerDependencies": {
    "react": "^16 || ^17 || ^18 || ^19",
    "react-dom": "^16 || ^17 || ^18 || ^19"
  }
}
